<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DorDamBDAndroid" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen starting theme. Applied only to MainActivity so the
         system splash uses the brand colour. postSplashScreenTheme switches
         back to the main theme once content is ready. -->
    <style name="Theme.DorDamBDAndroid.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DorDamBDAndroid</item>
    </style>

</resources>